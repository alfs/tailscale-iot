#pragma once

#include "esphome/core/log.h"
#include <string>
#include <vector>

// Forward declarations
namespace esphome {
namespace tailscale {
struct PeerInfo;
struct NodeConfig;
}
}

// Forward declare cJSON if using it
struct cJSON;

namespace esphome {
namespace tailscale {

/**
 * MapParser - Parse Tailscale/Headscale MapResponse JSON
 * 
 * Extracts node configuration and peer information from the control
 * server's map response. Uses lightweight parsing to minimize memory usage.
 * 
 * References:
 * - tailscale/tailcfg/tailcfg.go (MapResponse struct)
 * - headscale/hscontrol/mapper (map generation)
 * - REFACTOR.md Fix #3 (lite parser array depth tracking)
 */
class MapParser {
 public:
  MapParser();
  ~MapParser();

  /**
   * Parse a MapResponse JSON string
   * @param json_response The JSON string to parse
   * @param node_config Output struct for node configuration
   * @return true if parsing successful
   */
  bool parse(const std::string &json_response, NodeConfig &node_config);

  /**
   * Extract node information (ID, keys, IPs)
   */
  bool extract_node_info_(const char *json, NodeConfig &config);

  /**
   * Extract peer list
   */
  bool extract_peers_(const char *json, NodeConfig &config);

  /**
   * Extract DERP map information
   */
  bool extract_derp_map_(const char *json, NodeConfig &config);

 protected:
  /**
   * Find a JSON field by key
   * Returns pointer to the value, or nullptr if not found
   */
  const char *find_field_(const char *json, const char *key);

  /**
   * Extract a string value from JSON
   */
  bool extract_string_(const char *json, const char *key, std::string &value);

  /**
   * Extract an integer value from JSON
   */
  bool extract_int_(const char *json, const char *key, uint64_t &value);

  /**
   * Extract IPv4 address from Addresses array
   */
  bool extract_ipv4_address_(const char *json, std::string &ipv4);

  /**
   * Parse a single peer object
   */
  bool parse_peer_(const char *peer_json, size_t length, PeerInfo &peer);

  /**
   * Skip to the end of a JSON value (object, array, string, etc.)
   * Handles proper depth tracking for nested structures
   */
  const char *skip_value_(const char *cursor, int &depth);

 private:
  static const size_t MAX_PEERS = 50;  // Limit to avoid memory issues
};

}  // namespace tailscale
}  // namespace esphome
