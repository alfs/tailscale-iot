#pragma once

#include "esphome/core/log.h"
#include <string>
#include <vector>
#include <map>
#include <cstdint>

namespace esphome {
namespace tailscale {

/**
 * HTTP2Client - Simplified HTTP/2 client for Tailscale control protocol
 * 
 * Implements basic HTTP/2 functionality needed for:
 * - Registration requests
 * - Map requests (with streaming support)
 * - Noise-encrypted payloads
 * 
 * References:
 * - esphome/components/http_request
 * - tailscale/control/controlhttp
 * - headscale/hscontrol/poll.go
 */
class HTTP2Client {
 public:
  HTTP2Client();
  ~HTTP2Client();

  /**
   * Initialize the client with server URL
   */
  bool initialize(const std::string &server_url);

  /**
   * Perform an HTTP/2 POST request
   * @param path The URL path (e.g., "/machine/register")
   * @param payload The request body
   * @param headers Additional headers
   * @param response Output buffer for response body
   * @return true if request successful
   */
  bool post(const std::string &path, 
            const std::vector<uint8_t> &payload,
            const std::map<std::string, std::string> &headers,
            std::vector<uint8_t> &response);

  /**
   * Perform an HTTP/2 POST request with Noise encryption
   */
  bool post_encrypted(const std::string &path,
                      const std::vector<uint8_t> &plaintext,
                      const std::map<std::string, std::string> &headers,
                      std::vector<uint8_t> &response,
                      class NoiseProtocol *noise);

  /**
   * Set timeout for requests (milliseconds)
   */
  void set_timeout(uint32_t timeout_ms) { this->timeout_ms_ = timeout_ms; }

  /**
   * Get last HTTP status code
   */
  int get_last_status_code() const { return this->last_status_code_; }

 protected:
  /**
   * Detect complete JSON response by counting braces
   * This handles streaming responses that don't send END_STREAM flag
   */
  bool is_json_complete_(const std::string &json);

 private:
  std::string server_url_;
  std::string server_host_;
  uint16_t server_port_{443};
  uint32_t timeout_ms_{10000};
  int last_status_code_{0};
  bool initialized_{false};
};

}  // namespace tailscale
}  // namespace esphome
