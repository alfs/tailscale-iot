static const char *const TAG = "tailscale.noise";

NoiseProtocol::NoiseProtocol() {}

NoiseProtocol::~NoiseProtocol() {
  this->reset();
}

bool NoiseProtocol::initialize(const std::string &machine_key, const std::string &server_url) {
  ESP_LOGD(TAG, "Initializing Noise protocol");
  
  // TODO: Implement when noise-c is properly integrated
  ESP_LOGW(TAG, "Noise protocol initialization - placeholder implementation");
  
  this->initialized_ = true;
  return true;
}

bool NoiseProtocol::perform_handshake(const std::string &server_public_key) {
  if (!this->initialized_) {
    ESP_LOGE(TAG, "Protocol not initialized");
    return false;
  }
  
  ESP_LOGD(TAG, "Starting Noise_IK handshake");
  
  // TODO: Implement actual handshake when noise-c is integrated
  ESP_LOGW(TAG, "Noise handshake - placeholder implementation");
  
  this->handshake_complete_ = true;
  return true;
}

bool NoiseProtocol::encrypt_message(const std::vector<uint8_t> &plaintext, std::vector<uint8_t> &ciphertext) {
  if (!this->handshake_complete_) {
    ESP_LOGE(TAG, "Cannot encrypt: handshake not complete");
    return false;
  }
  
  // TODO: Implement actual encryption
  ESP_LOGW(TAG, "Encrypt message - placeholder (copying plaintext)");
  ciphertext = plaintext;
  return true;
}

bool NoiseProtocol::decrypt_message(const std::vector<uint8_t> &ciphertext, std::vector<uint8_t> &plaintext) {
  if (!this->handshake_complete_) {
    ESP_LOGE(TAG, "Cannot decrypt: handshake not complete");
    return false;
  }
  
  // TODO: Implement actual decryption
  ESP_LOGW(TAG, "Decrypt message - placeholder (copying ciphertext)");
  plaintext = ciphertext;
  return true;
}

std::string NoiseProtocol::get_machine_public_key() const {
  // TODO: Return actual public key
  return "placeholder_public_key";
}

void NoiseProtocol::reset() {
  this->initialized_ = false;
  this->handshake_complete_ = false;
}

bool NoiseProtocol::generate_keypair_() {
  // TODO: Implement key generation
  return true;
}

bool NoiseProtocol::decode_key_(const std::string &base64_key, uint8_t *key_buffer, size_t key_len) {
  size_t olen = 0;
  int ret = mbedtls_base64_decode(key_buffer, key_len, &olen, 
                                   (const uint8_t *)base64_key.c_str(), base64_key.length());
  
  if (ret != 0 || olen != key_len) {
    ESP_LOGE(TAG, "Base64 decode failed: %d (expected %zu bytes, got %zu)", ret, key_len, olen);
    return false;
  }
  
  return true;
}

std::string NoiseProtocol::encode_key_(const uint8_t *key_buffer, size_t key_len) {
  // Calculate output buffer size for base64
  size_t olen = 0;
  mbedtls_base64_encode(nullptr, 0, &olen, key_buffer, key_len);
  
  std::vector<uint8_t> output(olen);
  mbedtls_base64_encode(output.data(), output.size(), &olen, key_buffer, key_len);
  
  return std::string((char *)output.data(), olen);
}

}  // namespace tailscale
