#pragma once

#include "esphome/core/log.h"
#include <string>
#include <vector>
#include <cstdint>

// TODO: Include noise-c library headers
// For now, we'll forward declare the types we need
// #include <noise/protocol.h>

// Forward declarations for noise-c types
typedef struct NoiseHandshakeState_s NoiseHandshakeState;
typedef struct NoiseCipherState_s NoiseCipherState;
typedef struct NoiseDHState_s NoiseDHState;
typedef struct NoiseProtocolId_s NoiseProtocolId;
typedef struct NoiseBuffer_s NoiseBuffer;

#define NOISE_ERROR_NONE 0
#define NOISE_ROLE_INITIATOR 1

namespace esphome {
namespace tailscale {

/**
 * NoiseProtocol - Wrapper for Noise_IK handshake used in Tailscale TS2021
 * 
 * Implements the Noise_IK_25519_ChaChaPoly_BLAKE2s pattern for secure
 * communication with the Tailscale/Headscale control server.
 * 
 * References:
 * - tailscale/control/controlhttp/client.go
 * - headscale/hscontrol/noise.go
 * - noise-c library (external/noise-c)
 */
class NoiseProtocol {
 public:
  NoiseProtocol();
  ~NoiseProtocol();

  /**
   * Initialize the Noise protocol with server information
   * @param machine_key The machine's private key
   * @param server_url The control server URL
   * @return true if initialization successful
   */
  bool initialize(const std::string &machine_key, const std::string &server_url);

  /**
   * Perform the Noise_IK handshake
   * @param server_public_key The server's public key
   * @return true if handshake successful
   */
  bool perform_handshake(const std::string &server_public_key);

  /**
   * Encrypt a message using the established Noise transport
   * @param plaintext The message to encrypt
   * @param ciphertext Output buffer for encrypted message
   * @return true if encryption successful
   */
  bool encrypt_message(const std::vector<uint8_t> &plaintext, std::vector<uint8_t> &ciphertext);

  /**
   * Decrypt a message using the established Noise transport
   * @param ciphertext The encrypted message
   * @param plaintext Output buffer for decrypted message
   * @return true if decryption successful
   */
  bool decrypt_message(const std::vector<uint8_t> &ciphertext, std::vector<uint8_t> &plaintext);

  /**
   * Check if the handshake is complete and transport is ready
   */
  bool is_handshake_complete() const { return this->handshake_complete_; }

  /**
   * Get the machine public key (derived from private key)
   */
  std::string get_machine_public_key() const;

  /**
   * Reset the protocol state
   */
  void reset();

 protected:
  /**
   * Generate ephemeral key pair for handshake
   */
  bool generate_keypair_();

  /**
   * Convert base64 key to raw bytes
   */
  bool decode_key_(const std::string &base64_key, uint8_t *key_buffer, size_t key_len);

  /**
   * Encode raw bytes to base64
   */
  std::string encode_key_(const uint8_t *key_buffer, size_t key_len);

 private:
  NoiseHandshakeState *handshake_state_{nullptr};
  NoiseCipherState *send_cipher_{nullptr};
  NoiseCipherState *recv_cipher_{nullptr};
  
  uint8_t machine_private_key_[32];
  uint8_t machine_public_key_[32];
  uint8_t ephemeral_private_key_[32];
  uint8_t ephemeral_public_key_[32];
  uint8_t server_public_key_[32];
  
  bool initialized_{false};
  bool handshake_complete_{false};
};

}  // namespace tailscale
}  // namespace esphome
