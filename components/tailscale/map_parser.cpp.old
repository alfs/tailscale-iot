#include "map_parser.h"
#include "tailscale.h"
#include "esphome/core/log.h"
#include <cstring>
#include <cstdlib>

namespace esphome {
namespace tailscale {

static const char *const TAG = "tailscale.parser";

MapParser::MapParser() {}

MapParser::~MapParser() {}

bool MapParser::parse(const std::string &json_response, NodeConfig &node_config) {
  ESP_LOGI(TAG, "Parsing MapResponse (%zu bytes)", json_response.size());
  
  const char *json = json_response.c_str();
  
  // Extract node information
  if (!this->extract_node_info_(json, node_config)) {
    ESP_LOGE(TAG, "Failed to extract node info");
    return false;
  }
  
  ESP_LOGI(TAG, "✓ Node ID: %" PRIu64, node_config.node_id);
  ESP_LOGI(TAG, "✓ IPv4: %s", node_config.ipv4_address.c_str());
  
  // Extract peer list
  if (!this->extract_peers_(json, node_config)) {
    ESP_LOGW(TAG, "Failed to extract peers (may be empty)");
  } else {
    ESP_LOGI(TAG, "✓ Extracted %zu peer(s)", node_config.peers.size());
  }
  
  // Extract DERP map
  if (!this->extract_derp_map_(json, node_config)) {
    ESP_LOGW(TAG, "Failed to extract DERP map");
  }
  
  return true;
}

bool MapParser::extract_node_info_(const char *json, NodeConfig &config) {
  // Find the "Node" object
  const char *node_start = this->find_field_(json, "\"Node\"");
  if (!node_start) {
    ESP_LOGE(TAG, "\"Node\" field not found");
    return false;
  }
  
  // Extract ID
  if (this->extract_int_(node_start, "\"ID\"", config.node_id)) {
    ESP_LOGD(TAG, "Extracted Node ID: %" PRIu64, config.node_id);
  } else {
    ESP_LOGW(TAG, "Could not extract Node ID");
  }
  
  // Extract NodeKey
  if (this->extract_string_(node_start, "\"NodeKey\"", config.node_key)) {
    ESP_LOGD(TAG, "Extracted NodeKey (length: %zu)", config.node_key.length());
  }
  
  // Extract IPv4 address from Addresses array
  if (this->extract_ipv4_address_(node_start, config.ipv4_address)) {
    ESP_LOGD(TAG, "Extracted IPv4: %s", config.ipv4_address.c_str());
  } else {
    ESP_LOGW(TAG, "Could not extract IPv4 address");
  }
  
  return true;
}

bool MapParser::extract_peers_(const char *json, NodeConfig &config) {
  // Find the "Peers" array
  const char *peers_start = this->find_field_(json, "\"Peers\"");
  if (!peers_start) {
    ESP_LOGD(TAG, "\"Peers\" field not found (may be empty)");
    return false;
  }
  
  // Skip to the array start
  while (*peers_start && *peers_start != '[') {
    peers_start++;
  }
  if (*peers_start != '[') {
    return false;
  }
  peers_start++;  // Skip '['
  
  // Parse each peer object
  int depth = 0;
  const char *cursor = peers_start;
  
  while (*cursor && config.peers.size() < MAX_PEERS) {
    // Skip whitespace
    while (*cursor && (*cursor == ' ' || *cursor == '\n' || *cursor == '\t' || *cursor == '\r')) {
      cursor++;
    }
    
    if (*cursor == ']' && depth == 0) {
      break;  // End of peers array
    }
    
    if (*cursor == '{') {
      // Start of peer object
      const char *peer_start = cursor;
      cursor = this->skip_value_(cursor, depth);
      
      if (cursor > peer_start) {
        PeerInfo peer;
        if (this->parse_peer_(peer_start, cursor - peer_start, peer)) {
          config.peers.push_back(peer);
          ESP_LOGD(TAG, "Parsed peer #%zu: ID=%" PRIu64, config.peers.size(), peer.node_id);
        }
      }
    } else if (*cursor == ',') {
      cursor++;  // Skip comma between peers
    } else {
      cursor++;  // Skip other characters
    }
  }
  
  return !config.peers.empty();
}

bool MapParser::extract_derp_map_(const char *json, NodeConfig &config) {
  // Find the "DERPMap" object
  const char *derp_start = this->find_field_(json, "\"DERPMap\"");
  if (!derp_start) {
    ESP_LOGD(TAG, "\"DERPMap\" field not found");
    return false;
  }
  
  // TODO: Extract DERP region information
  // For now, just note that we found it
  ESP_LOGD(TAG, "DERPMap found");
  
  return true;
}

bool MapParser::parse_peer_(const char *peer_json, size_t length, PeerInfo &peer) {
  std::string peer_str(peer_json, length);
  const char *json = peer_str.c_str();
  
  // Extract peer ID
  this->extract_int_(json, "\"ID\"", peer.node_id);
  
  // Extract public key
  this->extract_string_(json, "\"Key\"", peer.public_key);
  
  // Extract endpoint (first one from Endpoints array)
  const char *endpoints = this->find_field_(json, "\"Endpoints\"");
  if (endpoints) {
    // Simple extraction of first endpoint
    const char *first_quote = strchr(endpoints, '"');
    if (first_quote) {
      first_quote++;  // Skip opening quote
      const char *second_quote = strchr(first_quote, '"');
      if (second_quote) {
        peer.endpoint = std::string(first_quote, second_quote - first_quote);
        
        // Extract port from endpoint (format: "ip:port")
        size_t colon_pos = peer.endpoint.rfind(':');
        if (colon_pos != std::string::npos) {
          peer.port = std::stoi(peer.endpoint.substr(colon_pos + 1));
          peer.endpoint = peer.endpoint.substr(0, colon_pos);
        }
      }
    }
  }
  
  // Assume peer is online if it has an endpoint
  peer.online = !peer.endpoint.empty();
  
  return peer.node_id > 0;
}

const char *MapParser::find_field_(const char *json, const char *key) {
  const char *found = strstr(json, key);
  if (!found) {
    return nullptr;
  }
  
  // Move past the key
  found += strlen(key);
  
  // Skip whitespace and colon
  while (*found && (*found == ' ' || *found == '\t' || *found == '\n' || *found == '\r' || *found == ':')) {
    found++;
  }
  
  return found;
}

bool MapParser::extract_string_(const char *json, const char *key, std::string &value) {
  const char *field = this->find_field_(json, key);
  if (!field || *field != '"') {
    return false;
  }
  
  field++;  // Skip opening quote
  const char *end = field;
  
  // Find closing quote (handle escaped quotes)
  bool escaped = false;
  while (*end) {
    if (escaped) {
      escaped = false;
    } else if (*end == '\\') {
      escaped = true;
    } else if (*end == '"') {
      break;
    }
    end++;
  }
  
  if (*end == '"') {
    value = std::string(field, end - field);
    return true;
  }
  
  return false;
}

bool MapParser::extract_int_(const char *json, const char *key, uint64_t &value) {
  const char *field = this->find_field_(json, key);
  if (!field) {
    return false;
  }
  
  // Parse the number
  char *end;
  value = strtoull(field, &end, 10);
  
  return (end != field);
}

bool MapParser::extract_ipv4_address_(const char *json, std::string &ipv4) {
  // Find Addresses array
  const char *addresses = this->find_field_(json, "\"Addresses\"");
  if (!addresses || *addresses != '[') {
    return false;
  }
  
  addresses++;  // Skip '['
  
  // Look for first IPv4 address (doesn't contain ':')
  const char *cursor = addresses;
  while (*cursor && *cursor != ']') {
    if (*cursor == '"') {
      cursor++;  // Skip opening quote
      const char *addr_start = cursor;
      
      // Find end of address
      while (*cursor && *cursor != '"') {
        cursor++;
      }
      
      std::string addr(addr_start, cursor - addr_start);
      
      // Check if it's IPv4 (contains '.' but not ':')
      if (addr.find('.') != std::string::npos && addr.find(':') == std::string::npos) {
        // Strip /32 suffix if present
        size_t slash = addr.find('/');
        if (slash != std::string::npos) {
          ipv4 = addr.substr(0, slash);
        } else {
          ipv4 = addr;
        }
        return true;
      }
    }
    cursor++;
  }
  
  return false;
}

const char *MapParser::skip_value_(const char *cursor, int &depth) {
  if (!cursor || !*cursor) {
    return cursor;
  }
  
  // Skip whitespace
  while (*cursor && (*cursor == ' ' || *cursor == '\n' || *cursor == '\t' || *cursor == '\r')) {
    cursor++;
  }
  
  if (*cursor == '{' || *cursor == '[') {
    // Object or array - track depth
    char open_char = *cursor;
    char close_char = (open_char == '{') ? '}' : ']';
    int local_depth = 1;
    cursor++;
    
    bool in_string = false;
    bool escaped = false;
    
    while (*cursor && local_depth > 0) {
      if (escaped) {
        escaped = false;
      } else if (*cursor == '\\') {
        escaped = true;
      } else if (*cursor == '"') {
        in_string = !in_string;
      } else if (!in_string) {
        if (*cursor == open_char) {
          local_depth++;
        } else if (*cursor == close_char) {
          local_depth--;
        }
      }
      cursor++;
    }
  } else if (*cursor == '"') {
    // String
    cursor++;
    bool escaped = false;
    while (*cursor) {
      if (escaped) {
        escaped = false;
      } else if (*cursor == '\\') {
        escaped = true;
      } else if (*cursor == '"') {
        cursor++;
        break;
      }
      cursor++;
    }
  } else {
    // Number, boolean, or null
    while (*cursor && *cursor != ',' && *cursor != '}' && *cursor != ']' && 
           *cursor != ' ' && *cursor != '\n' && *cursor != '\t' && *cursor != '\r') {
      cursor++;
    }
  }
  
  return cursor;
}

}  // namespace tailscale
}  // namespace esphome
