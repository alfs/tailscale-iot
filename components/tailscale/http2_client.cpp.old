#include "http2_client.h"
#include "noise_protocol.h"
#include "esphome/core/log.h"

namespace esphome {
namespace tailscale {

static const char *const TAG = "tailscale.http2";

HTTP2Client::HTTP2Client() {}

HTTP2Client::~HTTP2Client() {}

bool HTTP2Client::initialize(const std::string &server_url) {
  ESP_LOGD(TAG, "Initializing HTTP/2 client for %s", server_url.c_str());
  
  this->server_url_ = server_url;
  
  // Parse URL to extract host and port
  // Simple parsing: https://host:port or https://host
  size_t proto_end = server_url.find("://");
  if (proto_end == std::string::npos) {
    ESP_LOGE(TAG, "Invalid URL: missing protocol");
    return false;
  }
  
  std::string rest = server_url.substr(proto_end + 3);
  size_t port_pos = rest.find(":");
  size_t path_pos = rest.find("/");
  
  if (port_pos != std::string::npos && (path_pos == std::string::npos || port_pos < path_pos)) {
    this->server_host_ = rest.substr(0, port_pos);
    size_t port_end = (path_pos != std::string::npos) ? path_pos : rest.length();
    this->server_port_ = std::stoi(rest.substr(port_pos + 1, port_end - port_pos - 1));
  } else {
    size_t host_end = (path_pos != std::string::npos) ? path_pos : rest.length();
    this->server_host_ = rest.substr(0, host_end);
    this->server_port_ = 443;  // Default HTTPS port
  }
  
  ESP_LOGI(TAG, "✓ HTTP/2 client initialized: %s:%d", this->server_host_.c_str(), this->server_port_);
  this->initialized_ = true;
  return true;
}

bool HTTP2Client::post(const std::string &path,
                       const std::vector<uint8_t> &payload,
                       const std::map<std::string, std::string> &headers,
                       std::vector<uint8_t> &response) {
  if (!this->initialized_) {
    ESP_LOGE(TAG, "Client not initialized");
    return false;
  }
  
  ESP_LOGD(TAG, "POST %s (payload size: %zu bytes)", path.c_str(), payload.size());
  
  // TODO: Implement actual HTTP/2 request using ESP-IDF's esp_http_client
  // or nghttp2 library
  //
  // For now, this is a placeholder that needs to be implemented with:
  // 1. TLS connection to server
  // 2. HTTP/2 frame handling
  // 3. Stream management
  // 4. Header compression (HPACK)
  // 5. JSON response parsing with brace counting for streaming responses
  
  ESP_LOGW(TAG, "HTTP/2 POST not yet implemented (placeholder)");
  
  // Simulate successful response for testing
  this->last_status_code_ = 200;
  response.clear();
  
  return false;  // Return false until actually implemented
}

bool HTTP2Client::post_encrypted(const std::string &path,
                                 const std::vector<uint8_t> &plaintext,
                                 const std::map<std::string, std::string> &headers,
                                 std::vector<uint8_t> &response,
                                 NoiseProtocol *noise) {
  if (!noise || !noise->is_handshake_complete()) {
    ESP_LOGE(TAG, "Noise protocol not ready for encryption");
    return false;
  }
  
  // Encrypt the payload
  std::vector<uint8_t> encrypted_payload;
  if (!noise->encrypt_message(plaintext, encrypted_payload)) {
    ESP_LOGE(TAG, "Failed to encrypt payload");
    return false;
  }
  
  ESP_LOGD(TAG, "Encrypted payload: %zu -> %zu bytes", plaintext.size(), encrypted_payload.size());
  
  // Send the encrypted payload
  std::vector<uint8_t> encrypted_response;
  if (!this->post(path, encrypted_payload, headers, encrypted_response)) {
    return false;
  }
  
  // Decrypt the response
  if (!noise->decrypt_message(encrypted_response, response)) {
    ESP_LOGE(TAG, "Failed to decrypt response");
    return false;
  }
  
  ESP_LOGD(TAG, "Decrypted response: %zu bytes", response.size());
  return true;
}

bool HTTP2Client::is_json_complete_(const std::string &json) {
  // Count braces to detect complete JSON object
  // This handles streaming responses that don't send END_STREAM flag
  int brace_depth = 0;
  bool in_string = false;
  bool escaped = false;
  
  for (char c : json) {
    if (escaped) {
      escaped = false;
      continue;
    }
    
    if (c == '\\') {
      escaped = true;
      continue;
    }
    
    if (c == '"') {
      in_string = !in_string;
      continue;
    }
    
    if (!in_string) {
      if (c == '{') {
        brace_depth++;
      } else if (c == '}') {
        brace_depth--;
        if (brace_depth == 0) {
          return true;  // Complete JSON object
        }
      }
    }
  }
  
  return false;
}

}  // namespace tailscale
}  // namespace esphome
